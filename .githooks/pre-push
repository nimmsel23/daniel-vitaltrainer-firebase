#!/usr/bin/env bash
# pre-push: Änderungen unter gas/ -> clasp push + update-deployment (Account nimmdaniel).
# Überspringen mit SKIP_GAS_DEPLOY=1 git push
set -euo pipefail

[ "${SKIP_GAS_DEPLOY:-0}" = "1" ] && exit 0

root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
changed=0

while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # Branch-Löschung
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"       # neuer Branch: alles, was noch nicht auf einem Remote ist
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  if git diff --name-only $range -- gas/ 2>/dev/null | grep -q .; then
    changed=1
  fi
done

[ "$changed" = "0" ] && exit 0

# clasp pusht den Arbeitsbaum, nicht den Commit -> sonst wäre live != gepusht.
if [ -n "$(git status --porcelain -- gas/)" ]; then
  echo "pre-push: uncommittete Änderungen in gas/ – erst committen oder stashen." >&2
  exit 1
fi

echo "pre-push: gas/ geändert -> GAS deployen"
DEPLOY_NOTE="pre-push $(git rev-parse --short HEAD)" "$root/scripts/deploy-gas.sh"
